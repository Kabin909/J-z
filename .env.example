# J&Z Panel local-development environment
# The Docker Compose file also contains safe development fallbacks so
# `docker compose up --build` works even before this file is copied to `.env`.
# For production, ALWAYS replace every secret with a unique random value.

NODE_ENV=production
POSTGRES_DB=jz
POSTGRES_USER=jz
POSTGRES_PASSWORD=jz-local-postgres-change-me-please-1234567890
DATABASE_URL=postgresql://jz:jz-local-postgres-change-me-please-1234567890@postgres:5432/jz
REDIS_URL=redis://redis:6379
JWT_SECRET=jz-local-jwt-secret-change-me-1234567890
COOKIE_SECRET=jz-local-cookie-secret-change-me-1234567890
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
WS_PORT=4001
WINGS_SHARED_SECRET=jz-local-wings-secret-change-me-1234567890
NODE_ENCRYPTION_KEY=jz-local-node-encryption-key-1234567890
JZ_BOOTSTRAP_TOKEN=jz-local-bootstrap-token-change-me-1234567890

# UI defaults
JZ_BRAND=J&Z
JZ_PRODUCT_NAME=J&Z Panel
JZ_TAGLINE=Powerful infrastructure. Simple control. Built to scale.
JZ_WALLPAPER=/jz-wallpaper.png

# Optional first administrator (installer fills these in)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
