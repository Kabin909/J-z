# J&Z CodeSandbox development environment.
# CodeSandbox does not provide Docker/Wings/host control. Use a real PostgreSQL
# and Redis service for application state, then expose the selected web port.
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jz
REDIS_URL=redis://HOST:6379
JWT_SECRET=replace-with-a-32-plus-character-random-secret
COOKIE_SECRET=replace-with-a-32-plus-character-random-secret
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
WS_PORT=4001
WINGS_SHARED_SECRET=replace-with-a-32-plus-character-node-secret
NODE_ENCRYPTION_KEY=replace-with-a-32-plus-character-encryption-secret
JZ_BOOTSTRAP_TOKEN=replace-with-a-32-plus-character-bootstrap-token
JZ_DEPLOYMENT_TARGET=CODESANDBOX
JZ_SANDBOX_PORT=5173
# Optional: configure an externally provided public URL template.
# Example: https://YOUR-SANDBOX-HOST/{port}
JZ_SANDBOX_PUBLIC_URL_TEMPLATE=
